{
  "name": "genesis-bloodlines",
  "version": "1.0.0",
  "private": false,
  "description": "GENESIS: BLOODLINES - A dark fantasy dynasty simulator with genetic inheritance, base building, RPG combat and permadeath.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "game",
    "phaser",
    "rts",
    "dark-fantasy",
    "genetics",
    "simulation"
  ],
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "chrome-devtools-mcp": "^1.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  }
}
